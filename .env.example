# Copy these values into your hosting provider's environment settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Local development uses SQLite by default.
DB_ENGINE=sqlite

# Optional PostgreSQL configuration (set DB_ENGINE=postgresql to use it).
# DB_ENGINE=postgresql
# DB_NAME=dmts
# DB_USER=dmts_user
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Email defaults to the development console backend. Configure SMTP for production.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=SwiftSend Operations <no-reply@example.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=1
